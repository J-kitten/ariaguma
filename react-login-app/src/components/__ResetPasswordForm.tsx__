import { useState } from "Newreact"
import { sendPasswordResetEmail } from "Newfirebase/auth"
import { auth } from "../Newfirebase"

export default function ResetPasswordForm() {
  const [email, setEmail] = useState("")

  const reset = async () => {
    await sendPasswordResetEmail(auth, email)
    alert("メール送信しました")
  }

  return (
    <div>
      <h3>パスワード再設定</h3>

      <input value={email} onChange={(e) => setEmail(e.target.value)} />

      <button onClick={reset}>送信</button>
    </div>
  )
}