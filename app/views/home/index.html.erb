<% content_for :title, "Present[死闘の使命] ARIAGUMA" %>

<div class="bg-wrapper"></div>

<div class="container px-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-10" style="background-color: rgba(255, 255, 255, 0.8); padding: 20px;">
      <div class="container px-2 px-md-5">
        <div id="reserve_regist" class="noto-serif-jp-extra-light" style="font-size:16px; color: #000f33;">

          <img src="<%= asset_path('diamond.png') %>" style="height: 30px; width: 30px; margin-bottom: 5px; opacity: 0.7;"> Present電子書籍『死闘の使命』DOWNLOADのご予約</div>
          <br>
          <div class="noto-serif-jp-extra-light">
            ARIAGUMA GROUPは、電子書籍の企画・制作・公開を行う創作プロジェクトです。<br>
            主に呪術との闘い・恋愛・困難・再生などをテーマとしたオリジナルのノンフィクション電子書籍を制作致しており、インターネット上で公開、また書籍ファイル等のダウンロードができるよう制作中です。電子書籍は無料です。<br>
            制作完了まで暫くかかりそうですが、ご登録後、書籍完成時にメールでお知らせを致します。マイページのご利用・メールからダウンロード可能です。<br>
            <br>
            下記に、お名前とメールアドレスを入力・送信をなされてみてください。<br>
          </div>

          <div style="text-align: center">
          <% if flash[:admin_notice] %>
            <div class="noto-serif-jp-extra-light alert alert-info mb-0"><%= flash[:admin_notice].html_safe %></div>
          <% end %>

          <div class="container mt-4 noto-serif-jp-extra-light">
            <%= form_with model: @regist, url: home_create_path, local: true, data: { turbo: false } do |form| %>
              
              <div class="row mb-3 align-items-center">
                <div class="col-md-4 text-start text-md-end">
                  <%= form.label :name, "お名前（必須）", class: "form-label small-font mb-0", style: "font-size:11px;" %>
                </div>
                <div class="col-md-6">
                  <%= form.text_field :name, class: "form-control #{'is-invalid' if @regist.errors[:name].any?}", placeholder: "如月 まよ", maxlength: 50 %>
                  <% if @regist.errors[:name].any? %>
                    <div class="text-danger small"><%= @regist.errors.full_messages_for(:name).first %></div>
                  <% end %>
                </div>
              </div>

              <div class="row mb-3 align-items-center">
                <div class="col-md-4 text-start text-md-end">
                  <%= form.label :email, "メールアドレス（必須）", class: "form-label mb-0", style: "font-size:11px;" %>
                </div>
                <div class="col-md-6">
                  <%= form.email_field :email, class: "form-control #{'is-invalid' if @regist.errors[:email].any?}", placeholder: "contact@ariaguma.jp", maxlength: 100 %>
                  <% if @regist.errors[:email].any? %>
                    <div class="text-danger small"><%= @regist.errors.full_messages_for(:email).first %></div>
                  <% end %>
                </div>
              </div>

              <div class="row mb-4 align-items-center">
                <div class="col-md-4 text-start text-md-end">
                  <%= form.label :email_confirmation, "メールアドレス 確認用（必須）", class: "form-label mb-0", style: "font-size:11px;" %>
                </div>
                <div class="col-md-6">
                  <%= form.email_field :email_confirmation, class: "form-control #{'is-invalid' if @regist.errors[:email_confirmation].any?}", placeholder: "contact@ariaguma.jp", maxlength: 100 %>
                  <% if @regist.errors[:email_confirmation].any? %>
                    <div class="text-danger small"><%= @regist.errors.full_messages_for(:email_confirmation).first %></div>
                  <% end %>
                </div>
              </div>
              <div class="row">
                <div class="col-md-12 text-end noto-serif-jp-extra-light">
                  <%= form.submit "予約登録送信", 
                      id: "toggleButton", 
                      class: "btn btn-sm shadow noto-serif-jp-extra-light btn-hover rounded-pill px-4 py-4 my-button-blue", 
                      style: "background-color:#001a59; color:#f0eee0; font-size: 11px !important; line-height: 2; width: 200px" %>
                </div>
              </div>
              <br>
              <br>
              <br>
            <% end %>
          </div>
        </div>
      </div><!-- reserve_regist -->
    </div><!-- div col-md-8 col-lg-6 -->
  </div><!-- div container content px-4 -->
</div>

