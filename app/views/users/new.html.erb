<!-- app/views/users/new.html.erb -->

<div class="bg-wrapper"></div>

<br><br><br><br><br>

<div class="container" style="margin-top: 20px;">
  <div class="row justify-content-center">
    <div class="p-5 col-md-6 col-lg-4 noto-serif-jp-extra-light shadow rounded"
         style="background-color: #f8f9fa; max-width: 400px; width: 90%;">

      <div style="font-size:20px; color: #280033; background-color: rgba(255, 255, 255, 0.5); "></div>

      <h2 style="vertical-align: middle;">
        <img src="<%= asset_path('diamond.png') %>" alt="" style="height:35px; width: 35px; margin-bottom: 5px; opacity: 0.7;">
        <span style="position: relative; top: 2px;"> User登録</span>
      </h2>

      <% if flash[:notice] %>
        <div class="alert shadow mt-3" style="background-color: #20b2aa !important; color: #ffffff !important; font-size: 0.8rem; width: 300px;">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="alert font shadow mt-3" style="background-color: #cc0066; color: #ffffff !important; font-size: 0.8rem; width: 300px;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <br>

      <%= form_with model: @user, url: '/management_screen/create', method: :post do |f| %>

        <div class="mb-3">
          <%= f.label "お名前", class: "form-label" %>
          <%= f.text_field :name, 
                value: "",
                style: "width: 300px",
                class: "noto-serif-jp-extra-light form-control form-control-lg shadow #{'is-invalid' if flash[:alert] && params[:name].blank?}" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.text_field params[:email],
              style: "width: 300px",
              class: "noto-serif-jp-extra-light form-control form-control-lg shadow #{'is-invalid' if flash[:alert] && params[:email].blank?}",
              placeholder: "login@ariaguma.world.jp" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>

            <div style="position: relative; width: 300px;">
              <%= f.password_field :password,
                    id: "password-field", 
                    class: "noto-serif-jp-extra-light form-control form-control-lg shadow #{'is-invalid' if flash[:alert] && params[:password].blank?}",
                    placeholder: "パスワード",
                    style: "padding-right: 40px;" %>

              <%= image_tag "key.svg",
                    id: "toggle-password",
                    alt: "パスワード表示切替",
                    data: {
                      show_icon: asset_path("key_fill.svg"),
                      hide_icon: asset_path("key.svg")
                    },
                    style: "position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; width: 24px; height: 24px;" %>
            </div>
          <!--toggle.addEventListener("click", () => {
            console.log("CLICKED!");
          });-->

        <div style="text-align: right; padding-top: 20px;">
          <%= f.submit "Submit", class: "btn btn-info btn-lg", style: "min-width:80px;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<br>
<br>
<br>
<br>
<br>
<br>
