<!-- app/views/downloads/show.html.erb -->

<div class="bg-wrapper"></div>

<div class="container px-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-10" style="background-color: rgba(255, 255, 255, 0.8); padding: 20px;">

      <div class="container px-2 px-md-5">
        <div class="container py-4">

          <h4 class="noto-serif-jp-extra-light">
            <img
              src="<%= asset_path('diamond.png') %>"
              alt=""
              style="
                height: 25px;
                width: 25px;
                margin-bottom: 5px;
              "
            >
            Present 電子書籍『死闘の使命』
          </h4>

          <div class="noto-serif-jp-extra-light">

            <p>
              <%= @regist.name %> さん、
              長らくお待たせいたしました。
              電子書籍『死闘の使命』が完成いたしました。
            </p>

            <% if @download_file.present? %>
              <% download_limit =
                   @download_file.download_limit.presence || 10 %>

              <% if @regist.download_count.zero? %>
                <p>
                  ダウンロードは終わっていません。
                  右下のボタンを押してください。
                </p>

              <% elsif @regist.download_count < download_limit %>
                <p>
                  すでにダウンロード済みです。<br>

                  ダウンロード回数はあと
                  <%= download_limit - @regist.download_count %>
                  回可能です。
                </p>

              <% else %>
                <p>
                  ダウンロード上限に達しました。
                </p>
              <% end %>
            <% end %>

            <!-- 日本語の書籍のダウンロードボタン START -->
            <% if @download_file.present? %>
              <% download_limit =
                   @download_file.download_limit.presence || 10 %>

              <% if @regist.download_count < download_limit %>
                <div
                  style="
                    text-align: right;
                    margin-bottom: 1rem;
                  "
                >
                  <%= form_with(
                        url: download_file_path(
                          @regist.token,
                          download_file_id: @download_file.id
                        ),
                        method: :post,
                        local: true,
                        data: {
                          turbo: false
                        },
                        html: {
                          id: "download-form-ja",
                          style: "display: inline;"
                        }
                      ) do %>

                    <%= submit_tag(
                          "『死闘の使命』日本語 PDF FILE",
                          class:
                            "btn btn-download shadow rounded-pill " \
                            "d-inline-block px-4 py-3 btn-hover",
                          style:
                            "background-color: #dff7f7; " \
                            "color: black !important;"
                        ) %>
                  <% end %>
                </div>
              <% else %>
                <div
                  style="
                    text-align: right;
                    margin-bottom: 1rem;
                  "
                >
                  <button
                    type="button"
                    class="
                      btn btn-download shadow rounded-pill
                      d-inline-block px-4 py-2
                    "
                    style="
                      background-color: #dff7f7;
                      color: black !important;
                    "
                    disabled
                  >
                    ダウンロード上限に達しました。
                  </button>
                </div>
              <% end %>

            <% else %>
              <div class="alert alert-warning">
                現在、ダウンロードできるPDFファイルはありません。
              </div>
            <% end %>
            <!-- 日本語の書籍のダウンロードボタン END -->

            <br>
            <br>

            <h4 class="noto-serif-jp-extra-light">
              <img
                src="<%= asset_path('diamond.png') %>"
                alt=""
                style="
                  height: 25px;
                  width: 25px;
                  margin-bottom: 5px;
                "
              >
              二冊目の受け取りについて
            </h4>

            <p>
              もしかしたら、『死闘の使命』に続く
              二冊目の書籍も書くかもしれません。<br>

              欲しい方はボタンを押すと、
              完成時にURLをメールに記述してお送りします。<br>

              不要な方は、ボタンを押さなければ、
              二冊目の通知をお送りすることはありません。<br>

              「ON」ボタンを押すと、
              二冊目が完成した時に、
              メールにてダウンロード先のURLを
              お知らせいたします。
            </p>

            <br>

            <% if flash[:notice] %>
              <div
                class="
                  noto-serif-jp-extra-light
                  alert alert-info
                "
              >
                <%= flash[:notice] %>
              </div>
            <% end %>

            <% if flash[:alert] %>
              <div
                class="
                  noto-serif-jp-extra-light
                  alert alert-warning
                "
              >
                <%= flash[:alert] %>
              </div>
            <% end %>

            <div
              class="w-100 text-end"
              style="
                text-align: right;
                margin-bottom: 1rem;
              "
            >
              <%= form_with(
                    url: (
                      @regist.subscribed ?
                        unsubscribe_download_path(
                          @regist.token
                        ) :
                        subscribe_download_path(
                          @regist.token
                        )
                    ),
                    method: :patch,
                    local: true,
                    data: {
                      turbo: false
                    },
                    style: "display: inline-block;"
                  ) do %>

                <div
                  class="d-flex justify-content-end"
                  style="
                    padding-right: 20px;
                    align-items: center;
                    gap: 8px;
                  "
                >
                  <span>設定</span>
                  <span>OFF</span>

                  <div
                    class="form-check form-switch"
                    style="
                      margin: 0;
                      padding-left: 2.5em;
                    "
                  >
                    <%= check_box_tag(
                          :subscribed,
                          "1",
                          @regist.subscribed,
                          class: "form-check-input",
                          id: "subscribed_switch",
                          onchange: "this.form.submit();"
                        ) %>
                  </div>

                  <span>ON</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const downloadForms =
      document.querySelectorAll(
        "form[id^='download-form-']"
      );

    downloadForms.forEach(function(form) {
      form.addEventListener("submit", function() {
        const submitButton =
          form.querySelector(
            "input[type='submit'], button[type='submit']"
          );

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.value = "ダウンロード準備中です…";
        }

        setTimeout(function() {
          window.location.reload();
        }, 3000);
      });
    });
  });
</script>

