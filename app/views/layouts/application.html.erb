    <!-- 文字サイズ変更 start -->
    <script>
      function adjustFontSize(change) {
        const input = document.getElementById("fontSizeInput");
        let value = parseInt(input.value, 10) + change;

        if (value < 10) value = 10;
        if (value > 40) value = 40;

        input.value = value;
      }

      function applyFontSize() {
        const value = parseInt(document.getElementById("fontSizeInput").value, 10);
        const adjustedValue = Math.max(10, Math.min(value, 40));

        // ここをbodyではなくhtml要素に変更（優先度が高い）
        document.documentElement.style.fontSize = adjustedValue + "px";

        // 保存して次回も適用できるようにする
        sessionStorage.setItem('fontSize', adjustedValue);
      }

      /** フォントサイズパネルを、ナビゲーションバーに表示 **/
      /**「文字サイズ」「✕」ボタンで消せる START **/
      function toggleFontSizePanel() {
        const panel = document.getElementById('fontSizePanel');
        panel.style.display = panel.style.display === 'none' || panel.style.display === '' ? 'block' : 'none';
      }

      // ページ読み込み時にサイズ適用
      window.addEventListener('DOMContentLoaded', () => {
        const savedSize = sessionStorage.getItem('fontSize');
        if (savedSize) {
          document.documentElement.style.fontSize = savedSize + 'px';
          const input = document.getElementById("fontSizeInput");
          if (input) input.value = savedSize;
        }
      });
    /** フォントサイズパネルを、ナビゲーションバーに表示 **/
    /**「文字サイズ」「✕」ボタンで消せる END **/

    </script>
    <!-- 文字サイズ変更 End -->


    <% if defined?(@regist) && @regist && @regist.errors.any? %>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const invalid = document.querySelector(".is-invalid");
          if (invalid) {
            invalid.scrollIntoView({ behavior: "smooth", block: "center" });
            invalid.focus();
