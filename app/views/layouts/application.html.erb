    <% end %>

    <!--全文表示・閉じる Top画面 Start -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const moreText = document.getElementById("moreText");
        const button = document.getElementById("toggleButton");

        let isOpen = false;

        button.addEventListener("click", function () {
          if (isOpen) {
            /* 閉じるとき*/
            moreText.style.maxHeight = 0;
            button.textContent = "全文表示";
          } else {
            /* 開くときに高さを測って指定*/
            moreText.style.maxHeight = moreText.scrollHeight + "px";
            button.textContent = "閉じる";
          }
          isOpen = !isOpen;
        });
      });
    </script>
    <!--全文表示・閉じる Top画面 End -->

    <!-- JavaScriptで判定 → bodyにclass付与 -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const ua = navigator.userAgent.toLowerCase();

        if (ua.includes("fbav") || ua.includes("fban")) {
          document.body.classList.add("from-facebook");
        } else if (ua.includes("twitter")) {
          document.body.classList.add("from-x");
        } else if (ua.includes("instagram")) {
          document.body.classList.add("from-instagram");
        }
      });
    </script>

