            <button class="btn btn-outline-light font-adjust-btn" type="button" onclick="adjustFontSize(1)">＋</button>
        </div>
        <button class="btn btn-info w-100" onclick="applyFontSize();toggleFontSizePanel();" style="background-color:#99ebff;">
          変　更
        </button>
    </div>
