<!-- app/views/layouts/inquiry_layout.html.erb -->
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta http-equiv="content-language" content="ja">

  <title><%= content_for(:title) || "ARIAGUMA GROUP" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%# Includes all stylesheet files in app/assets/stylesheets %>

  <%= javascript_include_tag 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js', defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <!-- bootstrap.min.css -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- FONT -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cactus+Classical+Serif&family=Noto+Serif+JP:wght@200&display=swap" rel="stylesheet">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

  <script>
    function adjustFontSize(change) {
      const input = document.getElementById("fontSizeInput");
      let value = parseInt(input.value, 10) + change;

      if (value < 10) value = 10;
      if (value > 40) value = 40;

      input.value = value;
    }

    function applyFontSize() {
      const value = parseInt(document.getElementById("fontSizeInput").value, 10);
      const adjustedValue = Math.max(10, Math.min(value, 40));
      document.body.style.fontSize = adjustedValue + "px";

      // 必要であれば、この関数で実際の文字サイズ変更などを行う
      //alert(`フォントサイズを ${adjustedValue}px に変更します`);
    }


  /** フォントサイズパネルを、ナビゲーションバーに表示 **/
  /**「文字サイズ」「✕」ボタンで消せる START **/
    function toggleFontSizePanel() {
      const panel = document.getElementById('fontSizePanel');
      panel.style.display = panel.style.display === 'none' || panel.style.display === '' ? 'block' : 'none';
    }

    // ページ読み込み時にサイズ適用
    window.addEventListener('DOMContentLoaded', () => {
      const savedSize = sessionStorage.getItem('fontSize');
      if (savedSize) {
        document.body.style.fontSize = savedSize + 'px';
        document.getElementById('fontSizeInput').value = savedSize;
      }
    });
  /** フォントサイズパネルを、ナビゲーションバーに表示 **/
  /**「文字サイズ」「✕」ボタンで消せる END **/
  </script>



</head>
<body class="container py-4">
  <%= yield %>
</body>
</html>


