<% content_for :title, "ARIAGUMA 管理画面" %>

<div class="bg-wrapper"></div>

<div class="container" style="margin-top: 100px;">
  <div class="row justify-content-center">
    <div class="p-5 col-md-6 col-lg-4 noto-serif-jp-extra-light shadow rounded"
         style="background-color: rgba(255, 255, 255, 0.8); max-width: 400px; width: 90%;">

      <div style="font-size:20px; color: #280033; background-color: rgba(255, 255, 255, 0.5); "></div>

      <h2 style="vertical-align: middle;">
        <img src="<%= asset_path('diamond.png') %>" alt="" style="height:35px; width: 35px; margin-bottom: 5px; opacity: 0.7;">
        <span style="position: relative; top: 2px;"> Login</span>
      </h2>

      <% if current_user_info %>
        <p>ようこそ、<%= current_user_info[:name] %>さん</p>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert shadow mt-3" style="background-color: #20b2aa !important; color: #ffffff !important; font-size: 0.8rem; width: 300px;">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="alert font shadow mt-3" style="background-color: #cc0066; color: #ffffff !important; font-size: 0.8rem; width: 300px;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <br>

      <%= form_with(url: login_path, local: true, data: { turbo: false } ) do |f| %>
        <div class="mb-3">

          <%= f.label :email, class: "form-label" %>

          <%= f.text_field :email,
              style: "width: 340px",
              class: "noto-serif-jp-extra-light form-control form-control-lg custom-placeholder #{'is-invalid' if flash[:alert] && params[:email].blank?}",
              placeholder: "login@ariaguma.world.jp" %>

        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>

          <% if params[:email].blank? == false %>
            <div style="position: relative; width: 340px;">
              <%= f.password_field :password,
                    id: "password-field", 
                    class: "form-control form-control-lg custom-placeholder #{'is-invalid' if flash[:alert] && params[:password].blank?}",
                    placeholder: "パスワード",
                    style: "padding-right: 40px;" %>

              <%= image_tag "key.svg",
                    id: "toggle-password",
                    alt: "パスワード表示切替",
                    data: {
                      show_icon: asset_path("key_fill.svg"),
                      hide_icon: asset_path("key.svg")
                    },
                    style: "position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; width: 24px; height: 24px;" %>
            
            </div>
          <% end %>
          <!--toggle.addEventListener("click", () => {
            console.log("CLICKED!");
          });-->

          <% if params[:email].blank? == true %>
            <div style="position: relative; width: 340px;">
              <%= f.password_field :password,
                    id: "password-field", 
                    class: "form-control form-control-lg custom-placeholder #{'is-invalid' if flash[:alert] && params[:password].blank?}",
                    placeholder: "パスワード",
                    style: "padding-right: 40px;" %>

              <%= image_tag "key.svg",
                    id: "toggle-password",
                    alt: "パスワード表示切替",
                    data: {
                      show_icon: asset_path("key_fill.svg"),
                      hide_icon: asset_path("key.svg")
                    },
                    style: "position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; width: 24px; height: 24px;" %>
            
            </div>
          <% end %>

          <div class="d-flex justify-content-end w-100 mt-5" style="gap: 0px;">
<!--
            <%= link_to "User登録", 
                "/management_screen/signup",
                class: "btn shadow btn-download rounded-pill px-4 py-2 me-1", 
                style: "background-color:#001a59; color: #f0eee0; font-size: 0.8rem !important; line-height: 2;" %>
-->
            <%= f.submit "ログイン",
                class: "btn shadow btn-download rounded-pill px-4 py-3 title-link",
                style: "background-color: #fffcf4; color: #000000; font-size: 10px !important; line-height: 2; outline: 5px solid #000000; margin-right: 10px;" %>

            <%= link_to "ログアウト",
                management_screen_logout_path,
                method: :delete,
                data: { turbo: false, confirm: "ログアウトしますか？" },
                class: "btn shadow btn-download rounded-pill px-4 py-3 title-link",
                style: "background-color: #fffcf4; color: #000000; font-size: 10px !important; line-height: 2; outline: 5px solid #000000;" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

