<!-- app/views/contacts/index.html.erb -->
<h2>お問合せ一覧</h2>

<% if @contacts.present? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>お名前</th>
        <th>メールアドレス</th>
        <th>件名</th>
        <th>送信日時</th>
        <th>内容</th>
      </tr>
    </thead>
    <tbody>
      <% @contacts.each do |contact| %>
        <tr>
          <td><%= contact.name %></td>
          <td><%= contact.email %></td>
          <td><%= contact.subject %></td>
          <td><%= contact.created_at.strftime('%Y-%m-%d %H:%M') %></td>
          <td><%= contact.message.truncate(50) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>お問合せはありません。</p>
<% end %>
