<!-- app/views/management_screen/dashboard/index.html.erb -->
<br><br>

<div class="bg-wrapper"></div>

<div class="container px-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-11" style="background-color: rgba(255, 255, 255, 0.8); padding: 25px;">

      <div class="container px-2 px-md-5">
        <div class="d-flex justify-content-between align-items-center">
          <div style="padding-top: 10px; padding-bottom: 10px;">
            <h1 class="h4 mb-1">
              管理ダッシュボード
            </h1>
          </div>

          <div class="text-end text-muted">
            <%= l(
                  Time.current,
                  format: :long
                ) %>
          </div>
        </div>

        <div class="row g-4">

          <!-- 予約人数 -->
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card
                        border-0
                        h-100
                        dashboard-card">

              <div class="card-body p-4" style="color: white; background-color: #d7003a;">
                <div class="d-flex
                            justify-content-between
                            align-items-start">

                  <div style="padding-left: 20px;">
                    <p class="text-muted mb-2">
                      <span style="color: white;">
                        予約人数
                      </span>
                    </p>

                    <p class="display-6
                              fw-bold
                              mb-0">

                      <%= number_with_delimiter(
                            @regists_count
                          ) %>

                      <span class="fs-5 fw-normal">
                        人
                      </span>
                    </p>
                  </div>

                  <div class="dashboard-icon" style="padding-right: 20px;">
                    <i class="bi bi-people"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- お問い合わせ未返信 -->
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card
                        border-0
                        h-100
                        dashboard-card">

              <div class="card-body p-4" style="color: white; background-color: #d7003a;">
                <div class="d-flex
                            justify-content-between
                            align-items-start">

                  <div style="padding-left: 20px;">
                    <p class="text-muted mb-2">
                      <span style="color: white;">
                        お問い合わせ未返信
                      </span>
                    </p>

                    <p class="display-6
                              fw-bold
                              mb-0">

                      <%= number_with_delimiter(
                            @unanswered_contacts_count
                          ) %>

                      <span class="fs-5 fw-normal">
                        件
                      </span>
                    </p>
                  </div>

                  <div class="dashboard-icon" style="padding-right: 20px;">
                    <i class="bi bi-envelope"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 公開中電子書籍 -->
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card
                        border-0
                        h-100
                        dashboard-card">

              <div class="card-body p-4" style="color: white; background-color: #d7003a;">
                <div class="d-flex
                            justify-content-between
                            align-items-start">

                  <div style="padding-left: 20px;">
                    <p class="text-muted mb-2">
                      <span style="color: white;">
                        公開中電子書籍
                      </span>
                    </p>

                    <p class="display-6
                              fw-bold
                              mb-0">

                      <%= number_with_delimiter(
                            @published_books_count
                          ) %>

                      <span class="fs-5 fw-normal">
                        冊
                      </span>
                    </p>
                  </div>

                  <div class="dashboard-icon" style="padding-right: 20px;">
                    <i class="bi bi-book"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 制作中電子書籍 -->
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card
                        border-0
                        h-100
                        dashboard-card">

              <div class="card-body p-4" style="color: white; background-color: #d7003a;">
                <div class="d-flex
                            justify-content-between
                            align-items-start">

                  <div style="padding-left: 20px;">
                    <p class="text-muted mb-2">
                      <span style="color: white;">
                        制作中
                      </span>
                    </p>

                    <p class="display-6
                              fw-bold
                              mb-0">

                      <%= number_with_delimiter(
                            @unpublished_books_count
                          ) %>

                      <span class="fs-5 fw-normal">
                        冊
                      </span>
                    </p>
                  </div>

                  <div class="dashboard-icon" style="padding-right: 20px;">
                    <i class="bi bi-pencil-square"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 今日のダウンロード -->
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card
                        border-0
                        h-100
                        dashboard-card">

              <div class="card-body p-4" style="color: white; background-color: #d7003a;">
                <div class="d-flex
                            justify-content-between
                            align-items-start">

                  <div style="padding-left: 20px;">
                    <p class="text-muted mb-2">
                      <span style="color: white;">
                        今日のダウンロード
                      </span>
                    </p>

                    <p class="display-6
                              fw-bold
                              mb-0">

                      <%= number_with_delimiter(
                            @today_downloads_count
                          ) %>

                      <span class="fs-5 fw-normal">
                        回
                      </span>
                    </p>
                  </div>

                  <div class="dashboard-icon" style="padding-right: 20px;">
                    <i class="bi bi-download"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 今月のダウンロード -->
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card
                        border-0
                        h-100
                        dashboard-card">

              <div class="card-body p-4" style="color: white; background-color: #d7003a;">
                <div class="d-flex
                            justify-content-between
                            align-items-start">

                  <div style="padding-left: 20px;">
                    <p class="text-muted mb-2">
                      <span style="color: white;">
                        今月のダウンロード
                      </span>
                    </p>

                    <p class="display-6
                              fw-bold
                              mb-0">

                      <%= number_with_delimiter(
                            @month_downloads_count
                          ) %>

                      <span class="fs-5 fw-normal">
                        回
                      </span>
                    </p>
                  </div>

                  <div class="dashboard-icon" style="padding-right: 20px;">
                    <i class="bi bi-calendar-month"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <div class="row g-4 mt-1">

          <!-- 最近の予約 -->
          <div class="col-12 col-lg-6">
            <div class="card border-0 dashboard-card h-100">
              <div class="border-0
                          py-3"
                   style="margin-left: 20px; margin-top: 10px;">

                <h2 class="h5 mb-0">
                  最近の予約
                </h2>
              </div>

              <div class="card-body p-0">
                <% if @recent_regists.any? %>
                  <div class="table-responsive" style="margin-bottom: 15px; margin-right: 20px; margin-left: 20px;">
                    <table class="table
                                  table-hover
                                  align-middle
                                  mb-0">

                      <thead>
                        <tr>
                          <th>お名前</th>
                          <th>メールアドレス</th>
                          <th>予約日時</th>
                        </tr>
                      </thead>

                      <tbody>
                        <% @recent_regists.each do |regist| %>
                          <tr>
                            <td>
                              <%= regist.name %>
                            </td>

                            <td>
                              <%= regist.email %>
                            </td>

                            <td>
                              <%= l(
                                    regist.created_at,
                                    format: :short
                                  ) %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% else %>
                  <p class="text-muted p-4 mb-0">
                    予約情報はありません。
                  </p>
                <% end %>
              </div>
            </div>
          </div>

          <!-- 最近のお問い合わせ -->
          <div class="col-12 col-lg-6">
            <div class="card border-0 h-100 dashboard-card">
              <div class="border-0
                          py-3"
                   style="margin-left: 20px; margin-top: 10px;">

                <h2 class="h5 mb-0">
                  最近のお問い合わせ
                </h2>
              </div>

              <div class="card-body p-0">
                <% if @recent_contacts.any? %>
                  <div class="table-responsive" style="margin-bottom: 15px; margin-right: 20px; margin-left: 20px;">
                    <table class="table
                                  table-hover
                                  align-middle
                                  mb-0">

                      <thead class="table-light">
                        <tr>
                          <th>件名</th>
                          <th>お名前</th>
                          <th>状態</th>
                          <th>受信日時</th>
                        </tr>
                      </thead>

                      <tbody>
                        <% @recent_contacts.each do |contact| %>
                          <tr>
                            <td>
                              <%= truncate(
                                    contact.subject,
                                    length: 25
                                  ) %>
                            </td>

                            <td>
                              <%= contact.name %>
                            </td>

                            <td>
                              <% if contact.reply_time.present? %>
                                <span class="badge
                                             text-bg-secondary"
                                      style="background-color: #000000; color: #ffffff;">
                                  返信済
                                </span>
                              <% else %>
                                <span class="badge"
                                      style="background-color: #d7003a; color: #ffffff;">
                                  未返信
                                </span>
                              <% end %>
                            </td>

                            <td>
                              <%= l(
                                    contact.created_at,
                                    format: :short
                                  ) %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% else %>
                  <p class="text-muted p-4 mb-0">
                    お問い合わせはありません。
                  </p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <br>
      </div>
    </div>
  </div>
</div>