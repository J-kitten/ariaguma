<%# app/views/management_screen/contacts/show.html.erb %>

<style>
  .detail-wrapper {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
  }

  .title-purple {
    color: #47127d;
    text-align: center; /* タイトル中央寄せ */
    padding-right: 155px;
    padding-top: 10px;
  }

  .detail-box {
    max-width: 650px;
    margin: 0 auto;
    padding: 30px 20px;
  }

  .detail-table {
    width: 400px;
    margin: 0 auto; /* テーブル中央寄せ */
  }

  .detail-table th {
    text-align: right;
    width: 130px;
    font-weight: 500;
    vertical-align: middle;
  }

  .detail-table td {
    text-align: left; /* デフォルトは left、中央寄せなら center */
    vertical-align: middle;
  }

  .action-btn-group {
    display: flex;
    justify-content: center; /* ボタン中央寄せ */
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .action-btn {
    line-height: 1.2 !important;
    padding: 12px 25px !important;
    font-size: 0.8rem !important;
  }

  /* ボタン共通 */
  .btn-mail {
    background-color: #c9f5f6;
    font-size: 0.8rem !important;
    line-height: 2;
    color: #000;
    border-radius: 50px;
    padding: 6px 18px;
  }

  .btn-blue {
    background-color: #0d6efd;
    color: white;
    font-size: 0.8rem !important;
    line-height: 2;
    border-radius: 50px;
    padding: 6px 18px;
  }

  .btn-pink {
    background-color: #cc0066;
    color: white;
    font-size: 0.8rem !important;
    line-height: 2;
    border-radius: 50px;
    padding: 6px 18px;
  }

  /* タブレット用（幅768px～1024px） */
  @media screen and (max-width: 1024px) and (min-width: 768px) {
    .detail-box {
      padding: 25px;
    }

    .detail-table th {
      width: 150px;
      font-size: 0.85rem;
    }

    .action-btn-group {
      gap: 8px;
    }
  }

  .button-area {
    padding-top: 10px;
    padding-right: 100px;
    display: flex;
    justify-content: flex-end; /* 右寄せ */
    gap: 2px; /* ボタン同士の間隔を統一 */
  }

  /* スマホ用（幅767px未満） */
  @media screen and (max-width: 767px) {
    .detail-box {
      padding: 20px 15px;
    }

    .detail-table th {
      width: 100px;
      font-size: 0.75rem;
    }

    .action-btn-group {
      flex-direction: column;
      align-items: center; /* 中央寄せ */
    }

    .action-btn-group .btn {
      width: 100%;
      text-align: center;
    }

    .button-area {
      padding-bottom: 20px;
      padding-left: 10px;
      padding-right: 10px;
      flex-wrap: wrap;
      justify-content: center; /* スマホ時はバランス優先し中央寄せ */
      gap: 2px;
    }

  }

</style>

<div class="bg-wrapper"></div>
<br><br><br><br>

<div class="container noto-serif-jp-extra-light" style="align: center;">
  <div class="detail-wrapper">

    <div class="detail-box shadow bg-light rounded-pill">

      <table class="table table-borderless noto-serif-jp-extra-light align-middle mx-auto detail-table">
        <tr>
          <td colspan=3>
            <div class="title-purple" style="padding-left: 20px;">
              <% case params[:target] %>
              <% when 'trash' %>
                <h5 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > ゴミ箱一覧 > 詳細</h5>
              <% when 'unread' %>
                <h5 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > 未読 > 詳細</h5>
              <% when 'readed' %>
                <h5 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > 既読 > 詳細</h5>
              <% when 'all_contacts' %>
                <h5 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > 全件表示 > 詳細</h5>
              <% else %>
              <% end %>
            </div>
          </td>
        </tr>

        <tr>
          <th>ID</th><td style="padding-bottom: 10px;"></td><td><%= @contact.id %></td>
        </tr>
        <tr>
          <th>お名前</th><td style="padding-bottom: 10px;"></td><td><%= @contact.name %></td>
        </tr>
        <tr>
          <th>MAIL</th><td style="padding-bottom: 10px;"></td><td><%= @contact.email %></td>
        </tr>
        <tr>
          <th>件名</th><td style="padding-bottom: 10px;"></td><td><%= @contact.subject %></td>
        </tr>
        <tr>
          <th style="vertical-align: top;">メッセージ</th>
          <td style="padding-bottom: 10px;"></td>
          <td><%= simple_format(@contact.message) %></td>
        </tr>
        <tr>
          <th>返信日時</th>
          <td style="padding-bottom: 10px;"></td>
          <td>
            <% if @contact.reply_time.present? %>
              <%= l(@contact.reply_time, format: :long) %></td>
            <% else %>
              －
            <% end %>
          </td>
        </tr>
        <tr>
          <td colspan=3>
            <br>
            <div class="noto-serif-jp-extra-light button-area mt-4" style="text-align: right">
              <%= link_to "返信", 
                  reply_management_screen_contact_path(@contact, target: params[:target], page: params[:page]), 
                  class: "btn shadow rounded-pill btn-primary action-btn" %>

              <% case params[:target] %>
              <% when 'trash' %>
                <%= button_to "復元する", 
                    restore_management_screen_contact_path(@contact.id), 
                    method: :patch, 
                    data: { confirm: "本当に復元いたしますか？" }, 
                    class: "btn btn-hover-pink shadow rounded-pill action-btn",
                    form_class: "d-inline-block", 
                    style: "font-size: 0.8rem !important; line-height: 2; background-color: #b30384; color: #ffffff;" %>
              <%= link_to "戻る", 
                    trash_management_screen_contacts_path(page: params[:page]), 
                    class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
                    style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
                    onclick: "history.back(); return false;" %>
              <% when 'unread' %>
                <%= link_to "戻る", 
                    unread_management_screen_contacts_path(page: params[:page]), 
                    class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
                    style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
                    onclick: "history.back(); return false;" %>
              <% when 'readed' %>
                <%= link_to "戻る", 
                    readed_management_screen_contacts_path(page: params[:page]), 
                    class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
                    style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
                    onclick: "history.back(); return false;" %>
              <% when 'all_contacts' %>
                <%= link_to "戻る", 
                    management_screen_contacts_path(page: params[:page]), 
                    class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
                    style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
                    onclick: "history.back(); return false;" %>
              <% else %>
              <% end %>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </div>
</div>

