<%# app/views/management_screen/contacts/show.html.erb %>

<style>
  .detail-wrapper {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
  }

  .title-purple {
    color: #47127d;
    text-align: center; /* タイトル中央寄せ */
    padding-right: 155px;
    padding-top: 10px;
  }

  .detail-box {
    max-width: 650px;
    margin: 0 auto;
    padding: 30px 20px;
  }

  .detail-table {
    width: 400px;
    margin: 0 auto; /* テーブル中央寄せ */
  }

  .detail-table th {
    text-align: right;
    width: 130px;
    font-weight: 500;
    vertical-align: middle;
  }

  .detail-table td {
    text-align: left; /* デフォルトは left、中央寄せなら center */
    vertical-align: middle;
  }

  .action-btn-group {
    display: flex;
    justify-content: center; /* ボタン中央寄せ */
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .action-btn {
    line-height: 1.2 !important;
    padding: 12px 25px !important;
    font-size: 0.8rem !important;
  }

  /* ボタン共通 */
  .btn-mail {
    background-color: #c9f5f6;
    font-size: 0.8rem !important;
    line-height: 2;
    color: #000;
    border-radius: 50px;
    padding: 6px 18px;
  }

  .btn-blue {
    background-color: #0d6efd;
    color: white;
    font-size: 0.8rem !important;
    line-height: 2;
    border-radius: 50px;
    padding: 6px 18px;
  }

  .btn-pink {
    background-color: #cc0066;
    color: white;
    font-size: 0.8rem !important;
    line-height: 2;
    border-radius: 50px;
    padding: 6px 18px;
  }

  /* タブレット用（幅768px～1024px） */
  @media screen and (max-width: 1024px) and (min-width: 768px) {
    .detail-box {
      padding: 25px;
    }

    .detail-table th {
      width: 150px;
      font-size: 0.85rem;
    }

    .action-btn-group {
      gap: 8px;
    }
  }

  .button-area {
    padding-top: 10px;
    padding-right: 100px;
    display: flex;
    justify-content: flex-end; /* 右寄せ */
    gap: 2px; /* ボタン同士の間隔を統一 */
  }

  /* スマホ用（幅767px未満） */
  @media screen and (max-width: 767px) {
    .detail-box {
      padding: 20px 15px;
    }

    .detail-table th {
      width: 100px;
      font-size: 0.75rem;
    }

    .action-btn-group {
      flex-direction: column;
      align-items: center; /* 中央寄せ */
    }

    .action-btn-group .btn {
      width: 100%;
      text-align: center;
    }

    .button-area {
      padding-bottom: 20px;
      padding-left: 10px;
      padding-right: 10px;
      flex-wrap: wrap;
      justify-content: center; /* スマホ時はバランス優先し中央寄せ */
      gap: 2px;
    }

  }

  @media (max-width: 768px) {
    .responsive-container {
      width: 100% !important;
      padding: 0 1rem !important; /* 左右の余白を約0.5cmに抑える */
    }
  }

  @media (min-width: 769px) {
    .responsive-container {
      width: 50% !important;     /* PCでは元の幅 */
      margin: 0 auto;
    }
  }

  .action-btn {
    line-height: 1.2 !important;
    padding: 12px 25px !important;
    font-size: 0.8rem !important;
  }

</style>

<div class="bg-wrapper"></div>
<br><br><br><br>

<div class="container responsive-container noto-serif-jp-extra-light" style="font-size: 0.8rem;">

  <br>

  <div class="ms-6 mb-4 shadow bg-light rounded-pill p-5 px-5 py-5" style="font-size: 12px; padding-left: 70px;">
    <table border=0>
      <tr>
        <td colspan=3>
          <div class="d-flex gap-2">
            <% case params[:target] %>
            <% when 'trash' %>
              <h6 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > ゴミ箱一覧 > 詳細</h6>
            <% when 'unread' %>
              <h6 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > 未読 > 詳細</h6>
            <% when 'readed' %>
              <h6 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > 既読 > 詳細</h6>
            <% when 'all_contacts' %>
              <h6 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9;">お問合せ一覧 > 全件表示 > 詳細</h6>
            <% else %>
            <% end %>
          </div>
        </td>
      </tr>
      <tr>
        <td style="text-align: right; font-size: 11px !important;"><span style="padding-left: 35px;">お名前</span></td>
        <td width="10px;"></td>
        <td style="white-space: pre-wrap; font-size: 11px; !important;"><%= @contact.name %></td>
      </tr>
      <tr>
        <td style="text-align: right; font-size: 11px !important;"><span style="padding-left: 35px;">Mail</span></td>
        <td width="10px;"></td>
        <td style="white-space: pre-wrap; font-size: 11px; !important;"><%= @contact.email %></td>
      </tr>
      <tr>
        <td style="text-align: right; font-size: 11px !important;"><span style="padding-left: 35px;">件名</span></td>
        <td width="10px;"></td>
        <td style="white-space: pre-wrap; font-size: 11px; !important;"><%= @contact.subject %></td>
      </tr>
    </table>
  </div>



  <div class="ms-6 mb-4 shadow mt-1 rounded-5 px-5 py-5 p-5" style="font-size: 12px; padding-left: 70px; background-color: #f8f9fa !important;">
    <table>
      <tr>
        <td colspan=3>
          <span class="d-flex gap-2">
            <h6 class="rounded rounded-pill d-inline-block py-4 px-4" style="background-color: #eaeaf9; font-size: 10px !important;">本文</h6>
          </span>
        </td>
      </tr>
      <tr>
        <td>
          <p style="white-space: pre-wrap; font-size: 11px; !important;"><%= @contact.message %></p>
        </td>
      </tr>
    <table>
  </div>

</div>

<br><br><br>

<div class="text-end noto-serif-jp-extra-light">
  <%= link_to "返信", 
      reply_management_screen_contact_path(@contact, target: params[:target], page: params[:page]), 
      class: "btn shadow rounded-pill btn-primary action-btn" %>

  <% case params[:target] %>
  <% when 'trash' %>
    <%= button_to "復元する", 
        restore_management_screen_contact_path(@contact.id), 
        method: :patch, 
        data: { confirm: "本当に復元いたしますか？" }, 
        class: "btn btn-hover-pink shadow rounded-pill action-btn",
        form_class: "d-inline-block", 
        style: "font-size: 0.8rem !important; line-height: 2; background-color: #b30384; color: #ffffff;" %>
  <%= link_to "戻る", 
        trash_management_screen_contacts_path(page: params[:page]), 
        class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
        style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
        onclick: "history.back(); return false;" %>
  <% when 'unread' %>
    <%= link_to "戻る", 
        unread_management_screen_contacts_path(page: params[:page]), 
        class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
        style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
        onclick: "history.back(); return false;" %>
  <% when 'readed' %>
    <%= link_to "戻る", 
        readed_management_screen_contacts_path(page: params[:page]), 
        class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
        style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
        onclick: "history.back(); return false;" %>
  <% when 'all_contacts' %>
    <%= link_to "戻る", 
        management_screen_contacts_path(page: params[:page]), 
        class: "btn shadow rounded-pill px-4 py-2 btn-hover action-btn", 
        style: "background-color:#c9f5f6; font-size: 0.8rem !important; line-height: 2;",
        onclick: "history.back(); return false;" %>
  <% else %>
  <% end %>
</div>

