<!-- app/views/management_screen/download_files/show.html.erb -->

<br><br><br>

<div class="bg-wrapper"></div>

<div class="container px-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-10" style="background-color: rgba(255, 255, 255, 0.8); padding: 20px;">

      <div class="container px-2 px-md-5">

        <div class="container py-4">
          <h3 class="mb-4 h4">
            PDFファイル詳細
          </h3>

          <dl class="row">
            <dt class="col-sm-3">
              表示名
            </dt>

            <dd class="col-sm-9">
              <%= @download_file.name %>
            </dd>

            <dt class="col-sm-3">
              元のファイル名
            </dt>

            <dd class="col-sm-9">
              <%= @download_file.filename %>
            </dd>

            <dt class="col-sm-3">
              保存先
            </dt>

            <dd class="col-sm-9">
              <%= @download_file.path %>
            </dd>

            <dt class="col-sm-3">
              ファイルサイズ
            </dt>

            <dd class="col-sm-9">
              <%= @download_file.file_size_text %>
            </dd>

            <dt class="col-sm-3">
              ダウンロード回数
            </dt>

            <dd class="col-sm-9">
              <%= @download_file.download_count %>
            </dd>
          </dl>

          <div class="d-flex gap-2">
            <%= link_to "編集",
                  edit_management_screen_download_file_path(
                    @download_file
                  ),
                  class: "btn shadow btn-info rounded-pill px-5 py-4",
                  style: "color:#ffffff;" %>

            <%= link_to "戻る",
                  management_screen_download_files_path,
                  class: "btn rounded-pill shadow px-5 py-4",
                  style: "background-color:#dff7f7;" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
