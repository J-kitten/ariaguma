<%# app/views/management_screen/replies/index.html.erb %>

<!-- app/views/management_screen/replies/index.html.erb -->

<h4>最新のお問い合わせ一覧（メールアドレスごと）</h4>

<table class="table">
  <thead>
    <tr>
      <th>名前</th>
      <th>件名</th>
      <th>メール</th>
      <th>日時</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @contacts.each do |contact| %>
      <tr>
        <td><%= contact.name %></td>
        <td><%= contact.subject %></td>
        <td><%= contact.email %></td>
        <td><%= l(contact.created_at, format: :short) %></td>
        <td>
          <%= link_to '詳細', management_screen_contact_path(contact), class: "btn btn-sm btn-outline-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
