# HTTP PORT:80 --> HTTPS Redirect
server {
    listen 80;
    server_name ariaguma.jp www.ariaguma.jp;

    return 301 https://$host$request_uri;
}

# HTTPS PORT:443 ACCESS
server {
    listen 443 ssl;
    server_name ariaguma.jp www.ariaguma.jp;

    ssl_certificate /etc/letsencrypt/live/ariaguma.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ariaguma.jp/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /home/ubuntu/projects/ariaguma/public;

    location ^~ /management_screen/ {
        root /home/ubuntu/react_frontend/react-firebase-authentication-starter-kit/build/;
	index index.html
        try_files $uri /index.html;
    }

    # Rails API
    location /api/ {
        proxy_pass http://localhost:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
	#root /home/ubuntu/projects/ariaguma;
        proxy_pass http://localhost:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}


